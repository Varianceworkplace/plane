
{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests. One first load of the app after a release needs 313-338
	# of these files, and an office reaches the server from one address: at 300 a minute people got 429s, and the app
	# reloads when a file fails to load, asking for them all again. 6,000 a minute still stops abuse.
	@static_assets path /assets/* /static/* /favicon.ico /robots.txt

	rate_limit @static_assets {
		zone static {
			key {client_ip}
			events 6000
			window 1m
		}
	}

	# The build's files under /assets/ have their content hash in the name and never change: a browser keeps each
	# for a year instead of asking again, so moving between modules doesn't fetch them twice
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
